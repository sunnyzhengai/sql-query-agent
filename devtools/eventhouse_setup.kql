// Semantic catalog — PRODUCTION Eventhouse setup (ADR 0030 L3).
// Productizes the probe pattern verified 2026-08-08: full catalog,
// in-database embedding, and the semantic_search() stored function so
// the Data Agent generator calls ONE function instead of composing the
// embed/rank/threshold pipeline it repeatedly mangles.
//
// HOW TO RUN: one dot-command at a time (cursor inside the command, no
// selection). Queries (section 4 checks) run as single statements.
//
// PREREQS (once per environment — same as the probe):
//   a. Eventhouse item exists (reuse semantic_catalog or create "aivia-eh")
//   b. Every ASKING user holds "Cognitive Services OpenAI User" on the
//      customer's Azure OpenAI resource (group assignment recommended)
//   c. Callout policy allows the endpoint:
//      .alter-merge cluster policy callout @'[{"CalloutType":"azure_openai","CalloutUriRegex":"aivia\\.openai\\.azure\\.com","CanCall":true}]'
//
// REFRESH FLOW (each pipeline run, after 05) — verified 2026-08-09:
//   0. One-time: create a OneLake SHORTCUT in this KQL database pointing
//      at the lakehouse Delta table output_semantic_catalog (the Get
//      data wizard cannot see Delta tables — files only).
//   1. Copy through the shortcut, columns matched BY NAME (positional
//      copy bit us live: Spark createDataFrame(list-of-dicts) writes
//      columns alphabetically, and set-or-replace maps by position —
//      search_text received metric ids and 441 embeddings were computed
//      over the wrong column):
//        .set-or-replace semantic_catalog <| output_semantic_catalog
//        | project node_id, ['kind'], ['ref'], name, business_name,
//                  search_text, display_text, emb = dynamic(null)
//      (For incremental refresh, join against existing rows to keep
//      unchanged embeddings; full re-embed costs cents at catalog scale.)
//   2. Run section 2 to (re)embed — only rows with empty emb pay a call.

// ===== 1. Table (mirrors the SEMANTIC_CATALOG contract + emb) =========
// MIGRATING FROM THE PROBE? The probe's semantic_catalog has an older
// schema (description column, no kind/ref) — drop it first or its rows
// pollute search results:
//   .drop table semantic_catalog
// Also: never run with a SELECTION spanning two dot-commands — that
// yields "Syntax error: A recognition error occurred" (live, 2026-08-09).
// plain .create (drop first if the table exists). Earlier diagnosis
// blamed .create-merge; the real culprit was the unescaped `kind`
// column — .create-merge may be fine, untested since.
.create table semantic_catalog (
    node_id:string, ['kind']:string, ['ref']:string, name:string,
    business_name:string, search_text:string, display_text:string,
    emb:dynamic
    // kind and ref are KQL reserved words — bracket-escaped in DDL
    // (bare `kind` = "recognition error", live 2026-08-09; the editor's
    // red squiggle under kind was the tell)
)

.alter column semantic_catalog.emb policy encoding type='Vector16'

// ===== 2. Embed new/changed rows (in-database, impersonation) =========
// Re-runnable: only rows lacking a vector are embedded.
.set-or-replace semantic_catalog <|
    let todo = semantic_catalog | where isnull(emb) or array_length(emb) == 0;
    let done = semantic_catalog | where isnotnull(emb) and array_length(emb) > 0;
    let embedded = todo
        | evaluate ai_embeddings(search_text,
            'https://aivia.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-06-01;impersonate')
        | project node_id, ['kind'], ['ref'], name, business_name,
                  search_text, display_text, emb = search_text_embeddings;
    union done, embedded

// ===== 3. THE function the Data Agent calls =============================
// Owns the whole discipline: embed once, rank, threshold, disclose count.
// Threshold 0.35 CALIBRATED at full scale 2026-08-09 (441 rows, real
// search docs): true matches 0.41+, hardest adversarial junk ("unicorn
// readmission velocity" — contains a domain word) tops at 0.311. Note
// scores are NOT comparable across doc compositions: the 5-row probe
// scored 0.51/0.37 with shorter docs. Recalibrate whenever search_text
// composition changes.
.create-or-alter function with (
    docstring = "Semantic resolution over the certified catalog: returns the closest metrics/steps/terms for a topic phrase. total_matches on every row discloses how many cleared the threshold; closeness is relative similarity, never a probability.",
    folder = "aivia"
) semantic_search(phrase:string, top_k:int = 10, threshold:real = 0.35) {
    let q = toscalar(
        print t = phrase
        | evaluate ai_embeddings(t,
            'https://aivia.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-06-01;impersonate')
        | project t_embeddings);
    let scored = semantic_catalog
        | extend closeness = series_cosine_similarity(q, emb)
        | where closeness >= threshold;
    let total = toscalar(scored | count);
    scored
    | top top_k by closeness desc
    | project node_id, ['kind'], ['ref'], name, business_name,
              display_text, closeness, total_matches = total
}

// ===== 4. Verify =======================================================
// (a) Embedding coverage — expect 0:
semantic_catalog | where isnull(emb) or array_length(emb) == 0 | count

// (b) The function, end to end — expect the readmit step first:
semantic_search("patients who came back to the ER", 5)

// (c) Refusal floor — nonsense phrase; expect ZERO rows (this is what
//     keeps ADR 0005 alive in fuzzy matching):
semantic_search("unicorn readmission velocity")

// ===== 4b. Lineage functions (Fabric mitigation, 2026-08-23) ===========
// Sunny's ruling (HANDOFF_FABRIC_LINEAGE_MITIGATION): the Data Agent
// answers readers-of-table by NAME ASSOCIATION when it free-writes SQL
// (Round 4, name-cousin corpus). These functions own the homegrown
// lineage discipline on the Fabric surface: parsed edges NEVER name
// mentions; exact-name scope first; whole-token fallback only when no
// exact name exists (`has` = KQL term matching, mirroring the ops-layer
// _token_in law: 'ED' matches ED_SEPSIS, never AGGREGATED), disclosed
// in the `matched` column. PHI: names/refs only — no expression SQL.

.create-or-alter function with (
    docstring = "Certified metrics that READ a table, from parsed SQL lineage edges (transform_to_technical) - never name mentions. Exact table-name match first; whole-token fallback only when no exact table exists (the matched column discloses which). One row per table+metric: table_name, ref, business_name, matched. Use for: which metrics use / read / depend on table X. The distinct ref count IS the exact reader count.",
    folder = "aivia"
) readers_of_table(p_table:string) {
    let pairs = graph_nodes
        | where node_id startswith 'tech:'
        | project tech_id = node_id, table_name = name
        | join kind=inner (graph_edges
            | where edge_type == 'transform_to_technical'
            | project tech_id = target_id, source_id) on tech_id
        | extend ['ref'] = tostring(split(source_id, ':')[1])
        | distinct table_name, ['ref']
        | join kind=leftouter (semantic_catalog
            | where ['kind'] == 'metric'
            | project ['ref'], business_name) on ['ref']
        | project table_name, ['ref'], business_name;
    let exact_n = toscalar(pairs | where table_name =~ p_table | count);
    union
        (pairs | where table_name =~ p_table | extend matched = 'exact'),
        (pairs | where exact_n == 0 and table_name has p_table
               | extend matched = 'token')
    | order by table_name asc, ['ref'] asc
}

.create-or-alter function with (
    docstring = "Certified metrics that FILTER on a column (WHERE/CASE decision sites, relation='filters') or SELECT it (projection, relation='selects'), from parsed SQL lineage edges - never name mentions. Exact column-name match first; whole-token fallback only when no exact column exists (matched column discloses which). Rows: column_name, relation, ref, business_name, matched. Use for: which metrics filter on / select / touch column Y.",
    folder = "aivia"
) column_usage(p_column:string) {
    let cols = graph_nodes
        | where node_id startswith 'tech:'
            and array_length(split(node_id, '.')) == 3
        | project col_id = node_id, column_name = name;
    let usage = union
        (graph_edges | where edge_type == 'decision_to_column'
            | project col_id = target_id, source_id, relation = 'filters'),
        (graph_edges | where edge_type == 'transform_to_column'
            | project col_id = target_id, source_id, relation = 'selects');
    let pairs = cols
        | join kind=inner usage on col_id
        | extend ['ref'] = tostring(split(source_id, ':')[1])
        | distinct column_name, relation, ['ref']
        | join kind=leftouter (semantic_catalog
            | where ['kind'] == 'metric'
            | project ['ref'], business_name) on ['ref']
        | project column_name, relation, ['ref'], business_name;
    let exact_n = toscalar(pairs | where column_name =~ p_column | count);
    union
        (pairs | where column_name =~ p_column | extend matched = 'exact'),
        (pairs | where exact_n == 0 and column_name has p_column
               | extend matched = 'token')
    | order by column_name asc, relation asc, ['ref'] asc
}

// Verify 4b — all four must behave before agent wiring:
// (a) exact scope: readers_of_table('IP_SEPSIS') -> 5 rows, matched=exact
// (b) cousin isolation: readers_of_table('IP_SepsisEncounters') -> its
//     OWN readers only (never the IP_SEPSIS five)
// (c) token law: readers_of_table('ED') -> only tables with token ED
//     (never AGGREGATED-class substring matches)
// (d) column pair: column_usage('COMPILED_CONTEXT') -> filters rows > 0

// ===== 5. Data Agent wiring (portal) ===================================
// a. Add this KQL database as a SOURCE on the agents (alongside their
//    existing source); in schema selection tick semantic_catalog AND
//    the aivia/semantic_search function.
// b. Source instructions (paste):
//      To resolve a user's topic or metric reference, call
//      semantic_search('<core concept phrase>') FIRST. Use the returned
//      ref (metric_id or term_id) for any further lookups in other
//      sources. Report total_matches when > top rows shown. closeness
//      is relative similarity — never present it as a probability. If
//      semantic_search returns no rows, say the certified knowledge
//      base has nothing sufficiently related; do not guess.
// c. ONE example pair:
//      Q: "what do we have about cancelled appointments?"
//      KQL: semantic_search("cancelled appointments")
//    (the function call IS the whole query — that is the point)
