    "u12_patients":   {"proc": "USP_High_ED_Utilizers",     "schema": "reporting", "business_name": "High ED Utilizers", "steward": "ED Medical Director"},
    "u12_visits":     {"proc": "USP_High_ED_Utilizers",     "schema": "reports",   "business_name": "High ED Utilizers", "steward": "Finance Analyst"},
    "chain_linear":   {"proc": "USP_Care_Cascade",          "schema": "reporting", "business_name": "Care Cascade (Linear)"},
    "chain_diamond":  {"proc": "USP_Outreach_Funnel",       "schema": "reporting", "business_name": "Outreach Funnel (Diamond)"},
    "chain_self":     {"proc": "USP_Panel_Rollup",          "schema": "reporting", "business_name": "Panel Rollup (Recursive)"},
    "dynamic_sql":    {"proc": "USP_Adhoc_Extract",         "schema": "reporting", "business_name": "Adhoc Extract (Dynamic)"},
    "multi_stmt":     {"proc": "USP_Panel_Refresh",         "schema": "reporting", "business_name": "Panel Refresh (Multi-Statement)"},
    "crlf_a":         {"proc": "USP_Crlf_Probe_A",          "schema": "reporting", "business_name": "Line-Ending Probe A"},
    "crlf_b":         {"proc": "USP_Crlf_Probe_B",          "schema": "reporting", "business_name": "Line-Ending Probe B"},
    "phi_probe":      {"proc": "USP_Phi_Probe",             "schema": "reporting", "business_name": "PHI Literal Probe"}
  }
}
